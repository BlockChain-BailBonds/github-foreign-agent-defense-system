// WARD: connective detection for audited directory role and application changes.
// AuditLogs ingestion and exact activity names vary between tenants.
let StartTime = datetime(2026-10-13T00:00:00Z);
let WatchedAppIds = dynamic([
    "506e08f9-6e9a-4da4-942b-a099a03644ae",
    "24205314-2b89-4e07-a2a4-579e898a5640",
    "2399d300-6fca-4e6a-a686-399fefe75b83",
    "b78f6a77-d4e5-46fb-87e5-d1648bd02519",
    "0de14c77-b9b0-4137-9360-34878a929827",
    "412dcf96-176d-4b3a-a1b0-4981ad66971e",
    "b2b55f5b-7758-4719-8d8f-88ae172e6bdb"
]);
AuditLogs
| where TimeGenerated >= StartTime
| extend ActorAppId = tolower(tostring(InitiatedBy.app.appId))
| where ActorAppId in (WatchedAppIds)
| where OperationName has_any ("Add member to role", "Update application", "Add service principal credentials", "Update service principal")
| project TimeGenerated, OperationName, ActorAppId, Result, TargetResources, AdditionalDetails, CorrelationId
| order by TimeGenerated desc